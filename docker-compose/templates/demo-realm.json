            "name": "database-creds-read-permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"database-creds-read\"]",
              "applyPolicies": "[\"readers-group-policy\"]"
            }
          },
          {
            "name": "database-creds-write-permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
