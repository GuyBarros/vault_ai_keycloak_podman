          }
        ],
        "policies": [
          {
            "name": "readers-group-policy",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\":\"/readers\",\"extendChildren\":false}]"
            }
          },
          {
            "name": "writers-group-policy",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\":\"/writers\",\"extendChildren\":false}]"
            }
          },
