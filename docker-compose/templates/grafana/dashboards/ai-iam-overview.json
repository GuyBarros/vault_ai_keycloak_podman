{
  "__inputs": [],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "gauge",      "name": "Gauge",      "version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",      "version": "" }
  ],
  "description": "AI IAM Stack — active users, online agents, OBO flows and dynamic credentials",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "👤 Active Users & Sessions",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Number of jwt-keycloak logins (user-mcp presenting the human OBO token; Vault bound_claims on groups + scope) in the last 5 minutes. Each login roughly tracks a tool call needing DB credentials.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue",  "value": null },
            { "color": "green", "value": 1 }
          ]},
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 201,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto", "orientation": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "ceil(increase(vault_route_create_auth_jwt_keycloak__count[5m]))",
        "legendFormat": "Logins (5 m)"
      }],
      "title": "User Logins (5 m)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative jwt-keycloak logins since stack start (user-mcp presenting the human OBO token).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 202,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "vault_route_create_auth_jwt_keycloak__count",
        "legendFormat": "Total logins"
      }],
      "title": "Total User Logins",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active Vault leases. Each lease represents either an active OBO token or a dynamic database credential currently in use.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red",    "value": 30 }
          ]},
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 203,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "vault_expire_num_leases",
        "legendFormat": "Active leases"
      }],
      "title": "Active Vault Leases",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active Vault tokens (proxy for concurrent web-app sessions + service tokens).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 20 }
          ]},
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 204,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "vault_token_count",
        "legendFormat": "Tokens"
      }],
      "title": "Active Vault Tokens",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rate of user-mcp jwt-keycloak logins (human OBO) and ai-agent SPIFFE logins per minute.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 205,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vault_route_create_auth_jwt_keycloak__count[2m])",
          "legendFormat": "OIDC user logins/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vault_route_create_auth_jwt_spiffe__count[2m])",
          "legendFormat": "SPIFFE logins/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vault_expire_register_auth_count[2m])",
          "legendFormat": "Auth token registrations/s"
        }
      ],
      "title": "Web App Login Rate",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 210,
      "title": "🤖 Agent Instances Online",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Vault is up and unsealed — the core IAM authority is reachable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "options": { "0": { "text": "Down" }, "1": { "text": "Online" } }, "type": "value" }],
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 10 },
      "id": 211,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "vault_core_unsealed", "legendFormat": "Vault" }],
      "title": "Vault",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "ai-agent container is up (cAdvisor last seen within 60 s).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "options": { "0": { "text": "Offline" }, "1": { "text": "Online" } }, "type": "value" }],
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 10 },
      "id": 212,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "scalar(clamp_max(count(time() - container_last_seen{name=\"ai-agent\"} < 60), 1))",
        "legendFormat": "ai-agent"
      }],
      "title": "ai-agent",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "user-mcp container is up (cAdvisor last seen within 60 s).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "options": { "0": { "text": "Offline" }, "1": { "text": "Online" } }, "type": "value" }],
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 10 },
      "id": 213,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "scalar(clamp_max(count(time() - container_last_seen{name=\"user-mcp\"} < 60), 1))",
        "legendFormat": "user-mcp"
      }],
      "title": "user-mcp",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "token-exchange service is reachable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "options": { "0": { "text": "Offline" }, "1": { "text": "Online" } }, "type": "value" }],
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 10 },
      "id": 214,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "scalar(clamp_max(count(time() - container_last_seen{name=\"token-exchange\"} < 60), 1))",
        "legendFormat": "token-exchange"
      }],
      "title": "token-exchange",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "litellm proxy is reachable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "options": { "0": { "text": "Offline" }, "1": { "text": "Online" } }, "type": "value" }],
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 10 },
      "id": 215,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "scalar(clamp_max(count(time() - container_last_seen{name=\"litellm\"} < 60), 1))",
        "legendFormat": "litellm"
      }],
      "title": "litellm",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "keycloak is reachable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "options": { "0": { "text": "Offline" }, "1": { "text": "Online" } }, "type": "value" }],
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 10 },
      "id": 216,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "scalar(clamp_max(count(time() - container_last_seen{name=\"keycloak\"} < 60), 1))",
        "legendFormat": "keycloak"
      }],
      "title": "keycloak",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "SPIFFE logins (jwt-spiffe mount) = vault-agent/ai-agent renewing its SVID, plus user-mcp Transform (PII masking). Database credential logins use jwt-keycloak with the human OBO token — see the Session Audit OIDC panel.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "id": 217,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vault_route_create_auth_jwt_spiffe__count[2m])",
          "legendFormat": "SPIFFE logins/s (new)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vault_route_update_auth_jwt_spiffe__count[2m])",
          "legendFormat": "SPIFFE renewals/s"
        }
      ],
      "title": "Agent SPIFFE Auth Activity",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative SPIFFE logins since stack start — vault-agent/ai-agent plus user-mcp Transform. DB-cred logins are on jwt-keycloak, not this series.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 13 },
      "id": 218,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vault_route_create_auth_jwt_spiffe__count",
          "legendFormat": "SPIFFE logins total"
        }
      ],
      "title": "Total SPIFFE Logins",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total SPIFFE token renewals. vault-agent renews its token every ~30 min; a rising count = agent is continuously online.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 13 },
      "id": 219,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "vault_route_update_auth_jwt_spiffe__count",
        "legendFormat": "Renewals"
      }],
      "title": "Agent Token Renewals",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Container CPU usage for the core AI/IAM services — a flat line near zero for ai-agent between requests is normal.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1 }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 17 },
      "id": 220,
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rate(container_cpu_usage_seconds_total{name=~\"ai-agent|user-mcp|token-exchange|vault|keycloak|litellm\",name!=\"\"}[1m])",
        "legendFormat": "{{name}}"
      }],
      "title": "Agent / Service CPU",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 230,
      "title": "🔑 OBO Flow & Dynamic Credentials",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total active Vault leases right now. Leases are created for each dynamic DB credential and each OIDC actor token. A rising count without corresponding revocations may indicate a leak.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 15 },
            { "color": "red",    "value": 40 }
          ]},
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 24 },
      "id": 231,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "vault_expire_num_leases", "legendFormat": "Leases" }],
      "title": "Active Leases Now",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative dynamic Postgres credentials issued by Vault database engine. Each issuance = a user-mcp tool call that needed DB access.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 24 },
      "id": 232,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "vault_database_NewUser_count", "legendFormat": "DB creds" }],
      "title": "Dynamic DB Creds Issued",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative DB credential revocations. Should track close to issuances — a large gap means credentials are expiring rather than being cleanly revoked.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 24 },
      "id": 233,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "vault_database_DeleteUser_count", "legendFormat": "Revocations" }],
      "title": "DB Creds Revoked",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative PII transform encode calls (mask-ssn + mask-credit-card). Each call = a user record returned by user-mcp that contained sensitive fields.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] },
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 24 },
      "id": 234,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "vault_route_create_transform__count", "legendFormat": "PII masks" }],
      "title": "PII Transform Calls",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Vault OIDC token reads = actor token mints for OBO flow. Each read = ai-agent refreshing its actor token.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "teal", "value": null }] },
          "unit": "short",
          "noValue": "0"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 24 },
      "id": 235,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "vault_route_read_identity__count", "legendFormat": "Actor tokens" }],
      "title": "Actor Token Mints (OIDC)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active leases over time. Spikes indicate concurrent OBO token exchanges or DB credential bursts. Drops indicate revocations or TTL expiry.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 236,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vault_expire_num_leases",
          "legendFormat": "Active leases"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ceil(increase(vault_database_NewUser_count[5m]))",
          "legendFormat": "DB creds issued (5 m)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ceil(increase(vault_database_DeleteUser_count[5m]))",
          "legendFormat": "DB creds revoked (5 m)"
        }
      ],
      "title": "Active Leases & Dynamic Credentials Over Time",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "OBO + Vault flow activity: DB credential issuances, jwt-keycloak logins (human OBO bound_claims), SPIFFE (agent + Transform), and PII transform calls.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 237,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vault_route_read_database__count[2m])",
          "legendFormat": "DB cred requests/s (users.read scope)"
        },
        {
