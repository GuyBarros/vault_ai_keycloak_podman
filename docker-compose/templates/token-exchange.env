# Keycloak connection — must be reachable from the token-exchange container.
# Internal Docker network address.
IDENTITY_BROKER_KEYCLOAK_URL=http://keycloak:8080
IDENTITY_BROKER_KEYCLOAK_REALM=demo
# Confidential client that performs RFC 8693 token exchange.
IDENTITY_BROKER_OBO_CLIENT_ID=token-exchange
IDENTITY_BROKER_OBO_CLIENT_SECRET=token-exchange-secret
IDENTITY_BROKER_OBO_CLIENT_AUTH_METHOD=client_secret
# RFC 8693 audience: the resource server the exchanged token is intended for.
# Also the Keycloak Authorization Services (UMA) resource server that
# authorize_scope() queries as the live policy decision point — see
# Clients > user-mcp > Authorization in the Keycloak admin console.
IDENTITY_BROKER_KEYCLOAK_TOKEN_EXCHANGE_AUDIENCE=user-mcp
IDENTITY_BROKER_LOG_LEVEL=INFO
UVICORN_HOST=0.0.0.0
UVICORN_PORT=9090
