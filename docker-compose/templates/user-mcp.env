USER_MCP_VAULT_ADDR=http://vault:8200
USER_MCP_PG_URL=postgresql://postgres:5432/users?sslmode=disable
# Keycloak-issued OBO tokens carry the client_id as audience.
USER_MCP_AUDIENCE=user-mcp
# Internal Docker network Keycloak JWKS endpoint for the demo realm.
# Must use the internal hostname so the container can reach Keycloak directly.
USER_MCP_VERIFY_JWKS_URL=http://keycloak:8080/realms/demo/protocol/openid-connect/certs
# Keycloak stamps tokens with the KC_HOSTNAME-derived issuer (localhost:8081),
# not the internal Docker hostname. This value must match the `iss` claim in
# the OBO tokens produced by the token-exchange service.
USER_MCP_ISSUER=http://localhost:8081/realms/demo
USER_MCP_ALLOW_UNAUTH_DISCOVERY=true
USER_MCP_DB_AUTH_MODE=vault
USER_MCP_VAULT_VERIFY_TLS=false
USER_BACKEND=postgres
# Vault JWT auth via Keycloak OBO token — database credential issuance.
# user-mcp forwards the caller's validated OBO token to Vault's jwt-keycloak
# mount; Vault enforces bound_claims (aud=user-mcp, azp=token-exchange, scope).
USER_MCP_VAULT_KEYCLOAK_JWT_PATH=jwt-keycloak
USER_MCP_VAULT_KEYCLOAK_READ_ROLE=user-mcp-obo-read
USER_MCP_VAULT_KEYCLOAK_WRITE_ROLE=user-mcp-obo-write
# SPIFFE Workload API socket — used only by TransformMasker (PII masking).
USER_MCP_SPIFFE_SOCKET=/tmp/spire-agent/api.sock
USER_MCP_SPIFFE_JWT_AUDIENCE=user_mcp
USER_MCP_VAULT_SPIFFE_JWT_PATH=jwt-spiffe
USER_MCP_VAULT_SPIFFE_TRANSFORM_ROLE=user-mcp-spiffe-transform
# Enable Vault Transform Secret Engine PII masking
USER_MCP_TRANSFORM_ENABLED=true
USER_MCP_TRANSFORM_ROLE=user-mcp-transform
